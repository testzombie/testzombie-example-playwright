BASE_URL=http://demoweb2.testzombie.ai
HEADLESS=false
PLAYWRIGHT_RETRIES=0

# Required by @testzombie/playwright
TESTZOMBIE_API_KEY=
TESTZOMBIE_EMAIL=

# Optional. Defaults to https://testzombie.ai/api/
TESTZOMBIE_API_URL=https://testzombie.ai/api/

# Persistent Healing: off | preview | apply
TESTZOMBIE_SOURCE_UPDATE_MODE=off

# Optional. Defaults to the current project root in playwright.config.ts
# TESTZOMBIE_SOURCE_UPDATE_ROOT=

# Optional acceptance case for the deliberately invalid XPath / AI path
RUN_FORCED_AI_DEMO=false
